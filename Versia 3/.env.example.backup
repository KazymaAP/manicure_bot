# ╔══════════════════════════════════════════════════════════════╗
# ║           Telegram-бот для записи на маникюр                ║
# ║             Файл конфигурации (.env)                        ║
# ╚══════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ──────────────────────────────────────────────────────────────

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=1234567890:ABCDefGhIJKlmnoPQRStuvwXYZ

# Telegram ID администратора (мастера)
# Узнать свой ID: написать @userinfobot
ADMIN_IDS=123456789

# ──────────────────────────────────────────────────────────────
# БАЗА ДАННЫХ
# ──────────────────────────────────────────────────────────────

# Путь к файлу базы данных SQLite
DB_PATH=data/manicure_bot.db

# ──────────────────────────────────────────────────────────────
# НАСТРОЙКИ ЗАПИСИ
# ──────────────────────────────────────────────────────────────

# Временная зона (ВАЖНО для правильного времени напоминаний!)
# Примеры: Europe/Moscow, Asia/Yekaterinburg, Europe/Kiev
TIMEZONE=Europe/Moscow

# За сколько часов до визита отправлять напоминание (1-72)
REMINDER_HOURS_BEFORE=24

# Максимум активных записей у одного клиента
MAX_APPOINTMENTS_PER_USER=1

# Горизонт расписания (дней вперёд)
SCHEDULE_DAYS_AHEAD=30

# Слоты по умолчанию (через запятую, формат ЧЧ:ММ)
DEFAULT_TIME_SLOTS=["09:00","10:00","11:00","12:00","13:00","14:00","15:00","16:00","17:00","18:00"]

# ──────────────────────────────────────────────────────────────
# УСЛУГИ И ПРАЙС-ЛИСТ
# ──────────────────────────────────────────────────────────────
# Формат JSON: {"Название": {"price": Цена_в_рублях, "duration": Длительность_в_минутах}}
SERVICES={"Маникюр классический": {"price": 1200, "duration": 60}, "Маникюр с покрытием": {"price": 1800, "duration": 90}, "Педикюр": {"price": 2000, "duration": 90}, "Педикюр с покрытием": {"price": 2500, "duration": 120}, "Гель-лак": {"price": 800, "duration": 30}}

# ──────────────────────────────────────────────────────────────
# КОНТАКТНАЯ ИНФОРМАЦИЯ МАСТЕРА
# ──────────────────────────────────────────────────────────────

# Телефон мастера (отображается в разделе «Связаться»)
PHONE=+7 999 123-45-67

# Instagram (ссылка или @username)
INSTAGRAM=@master_nail_studio

# Адрес студии
ADDRESS=г. Москва, ул. Цветочная, д. 1, оф. 5

# Ссылка на карту (Google Maps или Яндекс.Карты)
MAPS_LINK=https://yandex.ru/maps/-/your_link_here

# ──────────────────────────────────────────────────────────────
# ФОТО ПРИВЕТСТВИЯ (опционально)
# ──────────────────────────────────────────────────────────────

# URL фотографии мастера для приветственного сообщения
# Загрузите фото на Telegram (отправьте боту @imagebot) или хостинг
# WELCOME_PHOTO_URL=https://example.com/photo.jpg

# ──────────────────────────────────────────────────────────────
# ПОРТФОЛИО (опционально)
# ──────────────────────────────────────────────────────────────

# URL портфолио — отображается как кнопка в главном меню
# PORTFOLIO_URL=https://www.instagram.com/your_account/

# ──────────────────────────────────────────────────────────────
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ──────────────────────────────────────────────────────────────

# Рабочие дни (1=Пн, 2=Вт, 3=Ср, 4=Чт, 5=Пт, 6=Сб, 7=Вс)
WORK_DAYS=[1,2,3,4,5,6]

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Файл для записи логов (null — только консоль)
LOG_FILE=bot.log

# ──────────────────────────────────────────────────────────────
# REDIS (опционально, для production)
# ──────────────────────────────────────────────────────────────
# Без Redis состояния пользователей теряются при перезапуске.
# Для production рекомендуется Redis.
# REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────────────────────
# ПОДПИСКА НА КАНАЛ (опционально)
# ──────────────────────────────────────────────────────────────
# Если задано — пользователи должны подписаться на канал
# REQUIRED_CHANNEL=@your_channel_name

# ──────────────────────────────────────────────────────────────
# HEALTH CHECK (опционально)
# ──────────────────────────────────────────────────────────────
# HEALTH_PORT=8080
# METRICS_TOKEN=your_secret_metrics_token
