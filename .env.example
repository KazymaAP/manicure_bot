# ═══════════════════════════════════════════════════════════════
# КОНФИГУРАЦИЯ БОТА ДЛЯ ЗАПИСИ НА МАНИКЮР
# ═══════════════════════════════════════════════════════════════
# Инструкция:
# 1. Скопируй этот файл: cp .env.example .env
# 2. Заполни обязательные поля (помечены ✅)
# 3. Настрой опциональные поля по желанию
# 4. Запусти бота: python main.py
# ═══════════════════════════════════════════════════════════════

# ── ✅ ОБЯЗАТЕЛЬНО: Токен бота ────────────────────────────────
# Получи у @BotFather в Telegram: /newbot
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ── ✅ ОБЯЗАТЕЛЬНО: Твой Telegram ID ─────────────────────────
# Узнай свой ID через @userinfobot или @getmyid_bot
ADMIN_IDS=YOUR_TELEGRAM_ID_HERE

# ── База данных ───────────────────────────────────────────────
# Путь к файлу SQLite (создаётся автоматически)
DB_PATH=data/manicure_bot.db

# ── Напоминания ───────────────────────────────────────────────
# За сколько часов до записи отправлять напоминание клиенту
REMINDER_HOURS_BEFORE=24

# ── Ограничения ───────────────────────────────────────────────
# Максимальное число активных записей на одного клиента
MAX_APPOINTMENTS_PER_USER=1

# ── Портфолио мастера ─────────────────────────────────────────
# Ссылка на портфолио (Instagram, Telegram-канал, сайт)
# Оставь пустым если не нужно
PORTFOLIO_URL=

# ── Канал с подпиской ─────────────────────────────────────────
# Укажи @username канала, на который нужно подписаться
# Оставь пустым для отключения проверки подписки
# ⚠️ ВАЖНО: добавь бота в канал как администратора с правом просмотра участников
REQUIRED_CHANNEL=

# ── Канал для расписания ──────────────────────────────────────
# ID канала куда бот публикует записи (-100XXXXXXXXXX)
# Оставь -1 для отключения публикации
SCHEDULE_CHANNEL_ID=-1

# ── Redis (опционально) ───────────────────────────────────────
# URL Redis для хранения FSM-состояний (рекомендуется для продакшн)
# Оставь закомментированным для использования MemoryStorage
# ⚠️ ВАЖНО: без Redis при перезапуске бота пользователи теряют прогресс записи!
# Рекомендуется для продакшн: раскомментируй и укажи URL Redis.
# REDIS_URL=redis://localhost:6379/0

# ── Логирование ───────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Путь к файлу логов (оставь пустым для вывода только в консоль)
LOG_FILE=bot.log

# ── Временная зона (FIXED) ────────────────────────────────────
# Используется для правильного расчёта времени напоминаний
# Примеры: UTC, Europe/Moscow, Europe/Kiev, Asia/Almaty
TIMEZONE=Europe/Moscow

# ── Фото приветствия (опционально) ───────────────────────────
# URL фотографии для приветственного сообщения
WELCOME_PHOTO_URL=

# ── Контактная информация ─────────────────────────────────────
# Телефон мастера (отображается по команде /contacts)
PHONE=
# Instagram или ссылка на соц.сеть
INSTAGRAM=
# Адрес студии
ADDRESS=
# Ссылка на карту (Google Maps / Яндекс.Карты)
MAPS_LINK=

# ── Порт Health-check сервера ────────────────────────────────
HEALTH_PORT=8080

# ── Безопасность /metrics ────────────────────────────────────
# Bearer-токен для защиты /metrics HTTP endpoint.
# Если не задан — /metrics доступен только с localhost (127.0.0.1).
# Рекомендуется задать сложный случайный токен для production.
# Пример генерации: python -c "import secrets; print(secrets.token_hex(32))"
METRICS_TOKEN=

# ── Услуги (JSON) ────────────────────────────────────────────
# Словарь услуг с длительностью (минуты) и ценой (руб.)
# Пример настройки:
#   SERVICES={"маникюр": {"duration": 60, "price": 1200}, "педикюр": {"duration": 90, "price": 1500}}
# Обязательно используй двойные кавычки для JSON! Весь JSON — в одну строку без переносов.
# Если оставить пустым {}, будет доступна только услуга "маникюр" по умолчанию.
SERVICES={}

# ── Рабочие дни недели ───────────────────────────────────────
# Список номеров дней недели (1=Пн, 2=Вт, ..., 7=Вс)
# По умолчанию: Пн-Пт = [1, 2, 3, 4, 5]
WORK_DAYS=[1, 2, 3, 4, 5]

# ── Inline режим (@bot) ──────────────────────────────────────
# ⚠️ ВАЖНО для фичи inline-поиска: нужно включить inline mode у @BotFather.
# Команда в @BotFather: /setinline -> выбери своего бота -> напиши любую подсказку.
# Без этого inline-режим (@username дата) будет игнорироваться.

# ── Webhook (ОТКЛЮЧЁН) ───────────────────────────────────────
# ⚠️ Webhook НЕ РЕАЛИЗОВАН. Бот работает ТОЛЬКО в режиме long polling.
# Поля WEBHOOK_URL и WEBHOOK_PORT присутствуют в коде но игнорируются.
# НЕ НУЖНО настраивать webhook для работы бота.
