# ═══════════════════════════════════════════════════════════════
# КОНФИГУРАЦИЯ БОТА ДЛЯ ЗАПИСИ НА МАНИКЮР
# ═══════════════════════════════════════════════════════════════
# Инструкция:
# 1. Скопируй этот файл: cp .env.example .env
# 2. Заполни обязательные поля (помечены ✅)
# 3. Настрой опциональные поля по желанию
# 4. Запусти бота: python main.py
# ═══════════════════════════════════════════════════════════════

# ── ✅ ОБЯЗАТЕЛЬНО: Токен бота ────────────────────────────────
# Получи у @BotFather в Telegram: /newbot
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ── ✅ ОБЯЗАТЕЛЬНО: Твой Telegram ID ─────────────────────────
# Узнай свой ID через @userinfobot или @getmyid_bot
ADMIN_IDS=YOUR_TELEGRAM_ID_HERE

# ── База данных ───────────────────────────────────────────────
# Путь к файлу SQLite (создаётся автоматически)
DB_PATH=data/manicure_bot.db

# ── Напоминания ───────────────────────────────────────────────
# За сколько часов до записи отправлять напоминание клиенту
REMINDER_HOURS_BEFORE=24

# ── Ограничения ───────────────────────────────────────────────
# Максимальное число активных записей на одного клиента
MAX_APPOINTMENTS_PER_USER=1

# ── Портфолио мастера ─────────────────────────────────────────
# Ссылка на портфолио (Instagram, Telegram-канал, сайт)
# Оставь пустым если не нужно
PORTFOLIO_URL=

# ── Канал с подпиской ─────────────────────────────────────────
# Укажи @username канала, на который нужно подписаться
# Оставь пустым для отключения проверки подписки
REQUIRED_CHANNEL=

# ── Канал для расписания ──────────────────────────────────────
# ID канала куда бот публикует записи (-100XXXXXXXXXX)
# Оставь -1 для отключения публикации
SCHEDULE_CHANNEL_ID=-1

# ── Redis (опционально) ───────────────────────────────────────
# URL Redis для хранения FSM-состояний (рекомендуется для продакшн)
# Оставь закомментированным для использования MemoryStorage
# REDIS_URL=redis://localhost:6379/0

# ── Логирование ───────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Путь к файлу логов (оставь пустым для вывода только в консоль)
LOG_FILE=bot.log
